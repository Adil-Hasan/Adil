---
import site from '../../public/site.json';
---

<section class="hero" id="home" aria-label={site.accessibility.introduction}>
  <figure class="hero-quote">
    <svg class="quote-mark" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M6.34375 3.9375l0 4.8125q0 1.09375-0.76563 1.85938-0.76563 0.76563-1.85937 0.76562-0.16406 0-0.30078-0.13672-0.13672-0.13672-0.13672-0.30078 0-0.16406 0.13672-0.30078 0.13672-0.13672 0.30078-0.13672 0.71094 0 1.23047-0.51953 0.51953-0.51953 0.51953-1.23047l0-0.4375-3.28125 0q-0.38281 0-0.62891-0.24609-0.24609-0.24609-0.24609-0.62891l0-3.5q0-0.38281 0.24609-0.62891 0.24609-0.24609 0.62891-0.24609l3.28125 0q0.38281 0 0.62891 0.24609 0.24609 0.24609 0.24609 0.62891z m5.46875-0.875l-3.28125 0q-0.38281 0-0.62891 0.24609-0.24609 0.24609-0.24609 0.62891l0 3.5q0 0.38281 0.24609 0.62891 0.24609 0.24609 0.62891 0.24609l3.28125 0 0 0.4375q0 0.71094-0.51953 1.23047-0.51953 0.51953-1.23047 0.51953-0.16406 0-0.30078 0.13672-0.13672 0.13672-0.13672 0.30078 0 0.16406 0.13672 0.30078 0.13672 0.13672 0.30078 0.13672 1.09375 0 1.85938-0.76563 0.76563-0.76563 0.76562-1.85937l0-4.8125q0-0.38281-0.24609-0.62891-0.24609-0.24609-0.62891-0.24609z" />
    </svg>
    <blockquote>
      <h1>
        <span class="quote-line"><span class="desktop-copy">{site.hero.desktopLines[0]}</span><span class="mobile-copy">{site.hero.mobileLines[0]}</span></span>
        <span class="quote-line"><span class="desktop-copy">{site.hero.desktopLines[1]}</span><span class="mobile-copy">{site.hero.mobileLines[1]}</span></span>
        <span class="quote-line mobile-copy">{site.hero.mobileLines[2]}</span>
        <span class="quote-line last-line"><span class="desktop-copy">{site.hero.desktopLastLine}</span><button class="physical-button" type="button"><span class="button-face">{site.hero.buttonLabel}</span></button><span class="question-mark">{site.hero.punctuation}</span></span>
      </h1>
    </blockquote>
    <figcaption>
      <span class="signature">{site.hero.signature}</span>
      <span class="aside">{site.hero.note}</span>
    </figcaption>
  </figure>
  <a class="scroll-cue" href="#projects" aria-label={site.hero.scrollLabel}>
    <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M11.53906 6.83594q0.05469 0.05469 0.05469 0.16406 0 0.10938-0.05469 0.16406l-4.375 4.375q-0.05469 0.05469-0.16406 0.05469-0.10938 0-0.16406-0.05469l-4.375-4.375q-0.10938-0.10938-0.08203-0.24609 0.02734-0.13672 0.16406-0.16406 0.13672-0.02734 0.24609 0.08203l4.21094 4.21094 4.21094-4.21094q0.05469-0.05469 0.16406-0.05469 0.10938 0 0.16406 0.05469z m-4.70312 0.32812q0.05469 0.05469 0.16406 0.05469 0.10938 0 0.16406-0.05469l4.375-4.375q0.10938-0.10938 0.08203-0.24609-0.02734-0.13672-0.16406-0.16406-0.13672-0.02734-0.24609 0.08203l-4.21094 4.21094-4.21094-4.21094q-0.05469-0.05469-0.13672-0.02735-0.08203 0.02734-0.13671 0.08204-0.05469 0.05469-0.08204 0.13671-0.02734 0.08203 0.02735 0.13672l4.375 4.375z" /></svg>
  </a>
  <span class="sr-only" id="button-status" role="status"></span>
</section>
