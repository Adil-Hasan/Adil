---
const { platform } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {platform === 'mail' && <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3" /><path d="m3 6 9 7 9-7M3 19l6-6m12 6-6-6" /></g>}
  {platform === 'facebook' && <path fill="currentColor" d="M14.3 22v-9h3l.5-3.5h-3.5V7.3c0-1 .3-1.7 1.8-1.7H18V2.5c-.3 0-1.5-.2-2.8-.2-2.8 0-4.7 1.7-4.7 4.8v2.4H7.4V13h3.1v9z" />}
  {platform === 'youtube' && <><rect x="1" y="4" width="22" height="16" rx="5" fill="currentColor" /><path d="m10 8 6 4-6 4z" fill="var(--contact-color)" /></>}
  {platform === 'linkedin' && <g fill="currentColor"><circle cx="4" cy="4" r="2" /><path d="M2 8h4v14H2zM9 8h4v2c1-1.5 2.2-2.3 4-2.3 3.8 0 5 2.4 5 6.2V22h-4v-7.2c0-2.2-.4-3.5-2.3-3.5-2 0-2.7 1.4-2.7 3.5V22H9z" /></g>}
