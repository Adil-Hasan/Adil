---
import site from '../../public/site.json';
---

<header class="site-header">
  <a class="wordmark" href="#home" aria-label={`${site.name}, ${site.accessibility.home}`}>{site.name}</a>
  <nav aria-label={site.accessibility.mainNavigation}>
    {Object.entries(site.sections).map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>
</header>
