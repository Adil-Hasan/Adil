---
import VacuumIcon from './VacuumIcon.astro';
import posters from '../../public/posters.json';
const base = import.meta.env.BASE_URL;
---

<div class="design-burst" aria-hidden="true"></div>
<aside class="cleanup-chat" data-poster-collision="solid" aria-label={posters.actions.cleanupLabel} hidden>
  <button class="cleanup-close" type="button" aria-label={posters.actions.dismiss} title={posters.actions.dismiss}>
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
  </button>
  <p id="cleanup-message" role="status"></p>
  <div class="cleanup-actions">
    <button class="cleanup-button" type="button" aria-label={posters.actions.clean} aria-describedby="vacuum-instructions" aria-pressed="false">
      <span class="cleanup-button-label">{posters.actions.clean}</span>
      <VacuumIcon class="cleanup-button-icon" />
    </button>
  </div>
  <span class="sr-only" id="vacuum-instructions">{posters.vacuumInstructions}</span>
</aside>
<div class="vacuum-field" aria-hidden="true" hidden></div>
<div class="vacuum-cursor" aria-hidden="true" hidden>
  <VacuumIcon wind />
</div>
<section class="screen-crash" role="dialog" aria-modal="true" aria-labelledby="crash-title" aria-describedby="crash-description" hidden>
  <div class="crash-content">
    <div class="crash-symbol" aria-hidden="true">:(</div>
    <h2 id="crash-title"></h2>
    <p id="crash-description"></p>
    <div class="crash-actions">
      <div class="crash-controls">
        <p class="crash-code">{posters.crash.code}</p>
        <button class="crash-reload" type="button">{posters.crash.reloadLabel}</button>
      </div>
    </div>
    <p class="crash-brand">{posters.crash.brand}</p>
    <button class="crash-qr" type="button" aria-label={posters.crash.errorDetailsLabel} title={posters.crash.errorDetailsLabel}>
      <img src={`${base}${posters.crash.image.src.replace(/^\.?\//, '')}`} alt={posters.crash.image.alt} width="132" height="132" />
    </button>
  </div>
</section>
