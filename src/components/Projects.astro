---
import site from '../../public/site.json';
---

<section class="content-section" id="projects" aria-labelledby="projects-title">
  <div class="section-heading">
    <h2 id="projects-title">{site.sections.projects}</h2>
  </div>
  <div class="projects-toolbar" hidden>
    <button class="projects-back" type="button" aria-label={site.projects.backLabel}>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H4m5-5-5 5 5 5" /></svg>
      <span>{site.projects.back}</span>
    </button>
  </div>
  <div class="section-content project-folders" id="project-folders" aria-live="polite">
    <p class="projects-status" role="status">{site.projects.loading}</p>
  </div>
  <div class="section-content project-images" id="project-images" hidden></div>
</section>
