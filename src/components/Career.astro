---
import career from '../../public/career.json';
import site from '../../public/site.json';
import { layoutCareerStickers } from '../scripts/career-layout.js';

const careerCards = career.cards.map((card, index) => ({ ...card, stickers: layoutCareerStickers(card), id: `career-chapter-${index + 1}` }));

const assetUrl = (path) => `${import.meta.env.BASE_URL}${path.replace(/^\.?\//, '')}`;
---

<section class="content-section career-section" id="career" aria-labelledby="career-title" style={`--career-image-height: ${career.settings.imageHeight}px; --image-padding: ${career.settings.padding}px`}>
  <div class="section-heading">
    <h2 id="career-title">{site.sections.career}</h2>
  </div>
  <div class="career-cards">
    {careerCards.map((card) => (
      <article class="career-entry" id={card.id} aria-labelledby={`${card.id}-title`}>
        <header class="career-caption">
          <h3 id={`${card.id}-title`}>{card.title}</h3>
          <p>{card.description}</p>
        </header>
        <div class="career-card" data-poster-collision="solid" style={`--card-color: ${card.color}`}>
          <div class="career-image-stage">
            {card.image && <img class="career-image" src={assetUrl(card.image.src)} alt={card.image.alt} loading="lazy" decoding="async" />}
            {card.stickers.map((sticker, index) => (
              <div class="career-sticker" data-tip-align={sticker.x < 30 ? 'start' : sticker.x > 70 ? 'end' : 'center'} style={`--sticker-x: ${sticker.x}%; --sticker-y: ${sticker.y}%; --sticker-width: ${sticker.width}%; --sticker-turn: ${sticker.rotation ?? 0}deg; --sticker-delay: ${index * -.8}s`}>
                <button type="button" aria-label={sticker.title} aria-expanded="false" aria-controls={`${card.id}-sticker-${index}`} aria-describedby={`${card.id}-sticker-${index}`}>
                  <img src={assetUrl(sticker.src)} alt="" loading="lazy" decoding="async" />
                </button>
                <div class="career-sticker-tip" data-poster-collision="solid" id={`${card.id}-sticker-${index}`} role="tooltip" hidden>
                  <strong>{sticker.title}</strong>
                  <span>{sticker.description}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
