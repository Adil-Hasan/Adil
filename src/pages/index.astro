---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Projects from '../components/Projects.astro';
import Career from '../components/Career.astro';
import FrameGen from '../components/FrameGen.astro';
import Contact from '../components/Contact.astro';
import PosterPlayground from '../components/PosterPlayground.astro';
---

<BaseLayout>
  <canvas id="dot-grid" aria-hidden="true"></canvas>
  <a class="skip-link" href="#main">Skip to content</a>
  <main id="main">
    <Hero />
    <SiteHeader />
    <div class="content-sections">
      <Projects />
      <Career />
      <FrameGen />
      <Contact />
    </div>
  </main>
  <PosterPlayground />
</BaseLayout>

<script>
  import '../scripts/app.js';
  import '../scripts/project-gallery.js';
  import '../scripts/career-flow.js';
</script>
